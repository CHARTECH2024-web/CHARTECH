# CHARTECH - CHARLES AI Secure Configuration
# Copy this file to .env and fill in your values

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# CHARLES AI Configuration
VITE_CHARLES_API_KEY=sk-your-openai-api-key
VITE_CHARLES_MODEL=gpt-4-turbo
VITE_CHARLES_ENDPOINT=https://api.openai.com/v1/chat/completions

# Backend Configuration
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/chartech
MONGODB_USER=admin
MONGODB_PASSWORD=your_secure_password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Security
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development
LOG_LEVEL=debug
